    {
      "parameters": {
        "jsCode": "// IRS query results — reference by node name\nconst queryRows = $('Query IRS Data').all();\n\n// Already-processed rows from Results sheet — handle empty sheet\nconst processedItems = $input.all();\nlet processedEINs = new Set();\n\ntry {\n  if (processedItems.length > 0 && processedItems[0].json.ein !== undefined) {\n    processedEINs = new Set(\n      processedItems.map(item => String(item.json.ein || '')).filter(id => id !== '')\n    );\n  }\n} catch (e) {\n  processedEINs = new Set();\n}\n\n// Filter to only NEW firms not yet in results\nconst newRows = queryRows.filter(item => {\n  const ein = String(item.json.ein || '');\n  return ein && !processedEINs.has(ein);\n});\n\n// Format for Clay webhook\nconst results = newRows.map(item => {\n  return {\n    json: {\n      ein: item.json.ein,\n      legal_name: item.json.legal_name,\n      dba_name: item.json.dba_name,\n      city: item.json.city,\n      state: item.json.state,\n      avg_returns_2yr: item.json.avg_returns_2yr\n    }\n  };\n});\n\nreturn results;"
      },
