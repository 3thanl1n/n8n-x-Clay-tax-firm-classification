    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  ein,\n  legal_name,\n  dba_name,\n  city,\n  state,\n  ROUND(AVG(total_returns)::numeric, 0) AS avg_returns_2yr\nFROM irs_filings\nWHERE \n  filing_year >= (EXTRACT(YEAR FROM CURRENT_DATE) - 2)\nGROUP BY \n  ein, legal_name, dba_name, city, state\nHAVING \n  AVG(total_returns) >= {{ $json.min_returns_threshold || 400 }}\nORDER BY avg_returns_2yr DESC\nLIMIT 1000;",
        "options": {}
      },
      "id": "c0d81753-f37e-4859-9cce-335e8c197c69",
      "name": "Query IRS Data",
