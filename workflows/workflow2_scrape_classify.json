    {
      "parameters": {
        "jsCode": "// Clay Output rows — reference by node name\nconst clayRows = $('Read Clay Output').all();\n\n// Already-processed rows from Results sheet — handle empty sheet\nconst processedItems = $input.all();\nlet processedEINs = new Set();\n\ntry {\n  // Only build the set if results sheet has data with ein column\n  if (processedItems.length > 0 && processedItems[0].json.ein !== undefined) {\n    processedEINs = new Set(\n      processedItems.map(item => String(item.json.ein || '')).filter(id => id !== '')\n    );\n  }\n} catch (e) {\n  // First run — results sheet is empty or has no columns yet\n  processedEINs = new Set();\n}\n\nfunction cleanUrl(url) {\n  if (!url) return '';\n  url = url.trim();\n  if (!url.startsWith('http')) return 'https://' + url;\n  return url;\n}\n\n// Filter to only NEW rows not yet in results\nconst newRows = clayRows.filter(item => {\n  const ein = String(item.json.ein || '');\n  return ein && !processedEINs.has(ein);\n});\n\n// Apply domain selection on new rows only\nconst results = newRows.map(item => {\n  const d = item.json;\n  let bestUrl = '';\n  let source = '';\n\n  if (d.company_website && d.company_website.trim() !== '') {\n    bestUrl = cleanUrl(d.company_website);\n    source = 'ai_validated';\n  } else if (d.domain && d.domain.trim() !== '') {\n    bestUrl = cleanUrl(d.domain);\n    source = 'default_enrichment';\n  }\n\n  if (!bestUrl) return null;\n\n  return {\n    json: {\n      ein: d.ein || '',\n      legal_name: d.legal_name || '',\n      dba_name: d.dba_name || '',\n      city: d.city || '',\n      state: d.state || '',\n      avg_returns_2yr: d.avg_returns_2yr || '',\n      domain: d.domain || '',\n      company_website: bestUrl,\n      domain_source: source\n    }\n  };\n}).filter(item => item !== null);\n\nreturn results;"
      },
