        "jsCode": "// Clay Find Companies rows — reference by node name\nconst clayRows = $('Read Clay Find + Enrich Companies Sheet').all();\n\n// Already-processed rows from Results sheet — handle empty sheet\nconst processedItems = $input.all();\nlet processedIDs = new Set();\n\ntry {\n  // Only build the set if results sheet has data with clay_id column\n  if (processedItems.length > 0 && processedItems[0].json.clay_id !== undefined) {\n    processedIDs = new Set(\n      processedItems.map(item => String(item.json.clay_id || '')).filter(id => id !== '')\n    );\n  }\n} catch (e) {\n  // First run — results sheet is empty or has no columns yet\n  processedIDs = new Set();\n}\n\nfunction cleanUrl(url) {\n  if (!url) return '';\n  url = url.trim();\n  if (!url.startsWith('http')) return 'https://' + url;\n  return url;\n}\n\n// Filter to only NEW rows not yet in results\nconst newRows = clayRows.filter(item => {\n  const id = String(item.json.Clay_ID || '');\n  return id && !processedIDs.has(id);\n});\n\n// Map to standard format for downstream nodes\nconst results = newRows.map(item => {\n  const d = item.json;\n  const domain = (d.Domain || '').trim();\n  \n  if (!domain) return null;\n\n  return {\n    json: {\n      clay_id: d.Clay_ID || '',\n      company_name: d.Name || '',\n      domain: domain,\n      company_website: cleanUrl(domain),\n      linkedin_url: d.LinkedIn_url || '',\n      size: d.Size || '',\n      annual_revenue_lower: d.Annual_Revenue_Lower_Bound || '',\n      annual_revenue_upper: d.Annual_Revenue_Upper_Bound || '',\n      annual_revenue: d['Annual Revenue'] || '',\n      location: d.Location || ''\n    }\n  };\n}).filter(item => item !== null);\n\nreturn results;"
      },
